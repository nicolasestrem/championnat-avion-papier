---
import { getEntry, render } from 'astro:content';
import InscriptionSection from '../../components/ui/InscriptionSection.astro';
import PageLayout from '../../layouts/PageLayout.astro';

const page = await getEntry('pages', 'politique-de-confidentialite');
const reglages = await getEntry('reglages', 'reglages');
const { Content } = await render(page!);

const breadcrumb = [
  { label: 'Accueil', href: '/' },
  { label: 'Politique de confidentialité', href: '/politique-de-confidentialite/' },
];
---

<PageLayout
  title={page!.data.title}
  seoTitle={page!.data.seoTitle}
  seoDescription={page!.data.seoDescription}
  breadcrumb={breadcrumb}
>
  <Content />
  <InscriptionSection slot="after-content" inscription={page!.data.inscription} reglages={reglages!.data} />
</PageLayout>
