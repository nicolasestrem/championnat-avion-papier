---
import { getEntry, render } from 'astro:content';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import PageLayout from '../../layouts/PageLayout.astro';

const page = await getEntry('pages', 'imprimer');
const reglages = await getEntry('reglages', 'reglages');
const r = reglages!.data;
const { Content } = await render(page!);

const breadcrumb = [
  { label: 'Accueil', href: '/' },
  { label: 'Tutoriels', href: '/ressources-avions-papier/' },
  { label: 'Avion en papier à imprimer', href: '/avion-papier-a-imprimer/' },
];
---

<PageLayout
  title={page!.data.title}
  seoTitle={page!.data.seoTitle}
  seoDescription={page!.data.seoDescription}
  image={page!.data.image?.src}
  breadcrumb={breadcrumb}
>
  <Content />
  <CtaBanner
    heading={r.inscriptionsOuvertes ? 'Prêt à faire décoller votre avion ?' : 'Inscriptions closes'}
    text={r.inscriptionsOuvertes
      ? `Rendez-vous le ${r.dateLabel} à ${r.ville}. Inscription ${r.tarifCompetiteur} par compétiteur.`
      : 'Les inscriptions pour cette édition sont closes.'}
    href={r.inscriptionsOuvertes ? r.helloAssoUrl : undefined}
    label={r.inscriptionsOuvertes ? 'S’inscrire au Championnat' : undefined}
  />
</PageLayout>
